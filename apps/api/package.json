{
  "name": "@quotes4/api",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "python3 -m uvicorn app.main:app --reload --host 0.0.0.0 --port 3001",
    "build": "python3 -m compileall app tests",
    "lint": "python3 -m ruff check app tests",
